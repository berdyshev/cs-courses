---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const entries = await getCollection('smartTech');
const lessonEntries = entries.sort((a, b) => a.data.lesson - b.data.lesson);
---
<Layout pageTitle="Smart Tech / ШІ">
  <div class="max-w-2xl mx-auto px-6 py-12">
    <a href={`${base}/`} class="text-sm text-gray-400 hover:text-gray-600 mb-6 inline-block no-print">← Всі курси</a>
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Smart Tech / ШІ</h1>
    <p class="text-gray-500 text-sm mb-8">9–11 клас · {lessonEntries.length} уроків</p>

    <ul class="space-y-2">
      {lessonEntries.map(entry => (
        <li>
          <a
            href={`${base}/smart-tech/${entry.data.lesson}`}
            class="flex items-center gap-3 p-4 bg-white rounded-lg border border-gray-200 hover:border-green-400 hover:shadow-sm transition-all"
          >
            <span class="text-xs font-mono text-gray-400 w-6">{String(entry.data.lesson).padStart(2, '0')}</span>
            <span class="text-gray-800 font-medium">{entry.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
